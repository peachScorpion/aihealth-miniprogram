/* 食寐有时 - 今日方案页样式 */
/* Palette: Cinnabar #C7513B, Bamboo #5A7A5A, Indigo #2C4A5A, Moon White #F7F3EC, Paper #FBF8F3, Ink #1C1814, Frost #8B8178 */

.page-plan {
  min-height: 100vh;
  background: #F7F3EC;
  padding-bottom: 160rpx;
}

/* ===== 顶部问候区 ===== */
.greeting-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(180deg, #FBF8F3 0%, #F7F3EC 100%);
}

.greeting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.greeting-info {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C4A5A;
}

.greeting-date {
  font-size: 24rpx;
  color: #8B8178;
  margin-top: 4rpx;
}

.constitution-tag {
  font-size: 24rpx;
  color: #C7513B;
  background: rgba(199, 81, 59, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

/* ===== 方案区域 ===== */
.plan-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C4A5A;
}

.section-badge {
  font-size: 22rpx;
  color: #5A7A5A;
  background: rgba(90, 122, 90, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* 餐食网格 */
.meals-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* 小贴士 */
.tips-card {
  margin-bottom: 16rpx;
  background: #FBF8F3;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(199, 81, 59, 0.06);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C4A5A;
  margin-bottom: 16rpx;
}

.tips-item {
  display: flex;
  font-size: 26rpx;
  color: #1C1814;
  opacity: 0.85;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.tips-dot {
  color: #C7513B;
  margin-right: 10rpx;
  font-weight: 700;
}

.disclaimer-note {
  text-align: center;
  font-size: 22rpx;
  color: #8B8178;
  padding: 16rpx 0;
}

/* ===== 加载态 ===== */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
}

.loading-animation {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C7513B;
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }
.loading-dot:nth-child(3) { animation-delay: 0s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 28rpx;
  color: #8B8178;
}

/* ===== 底部打卡栏 ===== */
.checkin-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 60rpx;
  background: linear-gradient(0deg, #F7F3EC 80%, transparent);
}

.checkin-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  background: #C7513B;
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-weight: 600;
}

.checkin-btn:active {
  background: #B1402D;
}

.checkin-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #5A7A5A;
  padding: 20rpx 0;
}

.checkin-done-icon {
  font-size: 32rpx;
  font-weight: 700;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-state-text {
  font-size: 28rpx;
  color: #8B8178;
  margin-bottom: 32rpx;
}

.btn-sm {
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  background: #C7513B;
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-weight: 600;
}

.btn-sm:active {
  background: #B1402D;
}

.mt-lg {
  margin-top: 0;
}