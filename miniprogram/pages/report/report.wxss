/* 食寐有时 - 效果追踪页样式 */
/* Palette: Cinnabar #C7513B, Bamboo #5A7A5A, Indigo #2C4A5A, Moon White #F7F3EC, Paper #FBF8F3, Ink #1C1814, Frost #8B8178, Gold #C4A265 */

.page-report {
  min-height: 100vh;
  background: #F7F3EC;
  padding-bottom: 120rpx;
}

/* ===== 顶部 Hero ===== */
.report-hero {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  overflow: hidden;
}

.report-hero-bg {
  position: absolute;
  top: -40rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  background: linear-gradient(135deg, #2C4A5A 0%, #3A5A6A 40%, #2C4A5A 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.report-hero-content {
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.hero-period {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* ===== 数据概览 ===== */
.stats-section {
  padding: 0 32rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #FBF8F3;
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  border: 1rpx solid rgba(199, 81, 59, 0.06);
}

.stat-card.accent {
  background: rgba(199, 81, 59, 0.04);
  border: 1rpx solid rgba(199, 81, 59, 0.12);
}

.stat-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #C7513B;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-card.accent .stat-value {
  color: #5A7A5A;
}

.stat-label {
  font-size: 26rpx;
  color: #2C4A5A;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.stat-unit {
  font-size: 22rpx;
  color: #8B8178;
}

/* ===== 趋势图 ===== */
.trend-card {
  background: #FBF8F3;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(199, 81, 59, 0.06);
}

.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C4A5A;
  margin-bottom: 28rpx;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 240rpx;
  padding: 0 8rpx;
}

.trend-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.trend-bar {
  width: 48rpx;
  background: linear-gradient(180deg, #5A7A5A 0%, #7AAA7A 100%);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 16rpx;
  transition: height 0.5s ease;
}

.trend-bar-value {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-top: 6rpx;
}

.trend-bar-label {
  font-size: 22rpx;
  color: #8B8178;
  margin-top: 10rpx;
}

/* ===== 餐食完成率 ===== */
.completion-card {
  background: #FBF8F3;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(199, 81, 59, 0.06);
}

.completion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.completion-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.completion-label {
  font-size: 26rpx;
  color: #2C4A5A;
  width: 140rpx;
  flex-shrink: 0;
}

.completion-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #E8E0D6;
  border-radius: 999rpx;
  overflow: hidden;
}

.completion-bar {
  height: 100%;
  background: #5A7A5A;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.completion-value {
  font-size: 24rpx;
  color: #5A7A5A;
  font-weight: 600;
  width: 60rpx;
  text-align: right;
}

/* ===== 改善建议 ===== */
.improvement-card {
  margin-bottom: 24rpx;
  background: rgba(90, 122, 90, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(90, 122, 90, 0.12);
}

.improvement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C4A5A;
  margin-bottom: 16rpx;
}

.improvement-text {
  font-size: 28rpx;
  color: #1C1814;
  opacity: 0.85;
  line-height: 1.8;
}

/* ===== 分享 ===== */
.share-section {
  padding: 32rpx;
}

.share-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  background: #C7513B;
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-weight: 600;
}

.share-btn:active {
  background: #B1402D;
}

.encourage-text {
  font-size: 28rpx;
  color: #C7513B;
  font-weight: 600;
  margin-top: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-state-text {
  font-size: 32rpx;
  color: #2C4A5A;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-state-sub {
  font-size: 26rpx;
  color: #8B8178;
  margin-bottom: 8rpx;
}