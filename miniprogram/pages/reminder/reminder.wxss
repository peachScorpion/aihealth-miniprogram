/* 食寐有时 - AI 智能提醒样式 */
/* Palette: Cinnabar #C7513B, Indigo #2C4A5A, Moon White #F7F3EC, Paper #FBF8F3, Ink #1C1814, Frost #8B8178 */

.page-reminder {
  min-height: 100vh;
  background: #F7F3EC;
  padding-bottom: 60rpx;
}

/* ===== 顶部标题 ===== */
.reminder-header {
  padding: 40rpx 32rpx 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C4A5A;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #8B8178;
}

/* ===== 提醒列表 ===== */
.reminder-list {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FBF8F3;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(199, 81, 59, 0.06);
}

.reminder-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.reminder-icon-wrap {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.reminder-icon-shape {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
}

/* Morning */
.icon-morning .reminder-icon-shape {
  background: rgba(199, 81, 59, 0.08);
  border: 2rpx solid rgba(199, 81, 59, 0.2);
  position: relative;
}

.icon-morning .reminder-icon-shape::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 16rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid #C7513B;
  box-shadow: 0 0 0 6rpx rgba(199, 81, 59, 0.1);
}

/* Lunch */
.icon-lunch .reminder-icon-shape {
  background: rgba(184, 133, 91, 0.08);
  border: 2rpx solid rgba(184, 133, 91, 0.2);
  position: relative;
}

.icon-lunch .reminder-icon-shape::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #B8845B;
  background: rgba(184, 133, 91, 0.15);
}

/* Bedtime */
.icon-bedtime .reminder-icon-shape {
  background: rgba(44, 74, 90, 0.08);
  border: 2rpx solid rgba(44, 74, 90, 0.2);
  position: relative;
}

.icon-bedtime .reminder-icon-shape::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #2C4A5A;
  clip-path: polygon(0 0, 70% 0, 70% 100%, 0% 100%);
}

/* Weekly */
.icon-weekly .reminder-icon-shape {
  background: rgba(90, 122, 90, 0.08);
  border: 2rpx solid rgba(90, 122, 90, 0.2);
  position: relative;
}

.icon-weekly .reminder-icon-shape::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #5A7A5A;
  border-radius: 4rpx;
}

.reminder-info {
  flex: 1;
}

.reminder-name {
  font-size: 30rpx;
  color: #2C4A5A;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.reminder-desc {
  font-size: 24rpx;
  color: #8B8178;
}

/* ===== 时间设置 ===== */
.time-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 24rpx;
  color: #8B8178;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.time-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.time-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FBF8F3;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(199, 81, 59, 0.06);
}

.time-label {
  font-size: 28rpx;
  color: #2C4A5A;
}

.time-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #C7513B;
  font-weight: 500;
  background: rgba(199, 81, 59, 0.06);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.time-arrow {
  font-size: 24rpx;
  color: #C7513B;
}

/* ===== 底部操作 ===== */
.action-section {
  padding: 0 32rpx;
}

.subscribe-all-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  background: #C7513B;
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subscribe-all-btn:active {
  background: #B1402D;
}

.action-hint {
  text-align: center;
  font-size: 24rpx;
  color: #8B8178;
}