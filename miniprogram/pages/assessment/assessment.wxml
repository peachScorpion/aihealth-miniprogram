<!-- 食寐有时 - 体质评估问卷 -->
<view class="page-assessment">
  <!-- 顶部进度区 -->
  <view class="progress-section">
    <view class="progress-header">
      <view class="progress-title">体质评估</view>
      <view class="progress-count">{{currentIndex + 1}} / {{totalQuestions}}</view>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-bar-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="progress-hint">请根据近一个月的情况如实回答</view>
  </view>

  <!-- 题目区域 -->
  <view class="question-section">
    <view class="question-card">
      <view class="question-number">Q{{currentIndex + 1}}</view>
      <view class="question-text">{{currentQuestion.text}}</view>
      <view class="question-type-tag">{{currentQuestion.type === 'multiple' ? '可多选' : '单选'}}</view>
    </view>

    <!-- 选项列表 -->
    <view class="options-list">
      <view 
        wx:for="{{currentQuestion.options}}" 
        wx:key="value"
        class="option-item {{utils.isSelected(selectedValues, item.value) ? 'selected' : ''}}"
        bindtap="selectOption"
        data-value="{{item.value}}"
      >
        <view class="option-radio">
          <view wx:if="{{utils.isSelected(selectedValues, item.value)}}" class="option-radio-inner"></view>
        </view>
        <text class="option-label">{{item.label}}</text>
        <view wx:if="{{utils.isSelected(selectedValues, item.value)}}" class="option-check">&#10003;</view>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="action-section">
    <view class="action-row">
      <button 
        wx:if="{{currentIndex > 0}}"
        class="btn btn-outline btn-prev"
        bindtap="prevQuestion"
      >
        上一题
      </button>
      
      <button 
        wx:if="{{currentIndex < totalQuestions - 1}}"
        class="btn btn-primary btn-next {{selectedValues.length ? '' : 'disabled'}}"
        bindtap="nextQuestion"
      >
        下一题
      </button>

      <button 
        wx:else
        class="btn btn-primary btn-submit {{selectedValues.length ? '' : 'disabled'}}"
        bindtap="submitAssessment"
      >
        提交评估
      </button>
    </view>
  </view>
</view>