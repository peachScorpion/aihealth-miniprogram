.loading-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 0; }
.loading-spinner { width: 64rpx; height: 64rpx; margin-bottom: 24rpx; }
.spinner-ring { width: 100%; height: 100%; border: 4rpx solid #F0E8DF; border-top-color: #E8913A; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #8B7E6E; }